doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Countdown Clock
    link(rel="stylesheet", href="css/main.css")
  body
    h1 hello world
    section.countdown
      #days
        span.value
        span.label
      #hours
        span.value
        span.label
      #minutes
        span.value
        span.label
      #seconds
        span.value
        span.label

    #info-card.hidden
      p
        strong Parameters:
        br
        | title: Text to display
        br
        | y, m, d: Year, Month, Day
        br
        | hour, min, sec: Hour, Minute, Second
      p Note: If you clear date fields and only use time, it generates a countdown from now.

    button#info-toggle info

    script(src="js/main.js")
